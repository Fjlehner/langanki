{
  // Static site in ./public, plus a small sync API at /api/* (src/worker.js).
  "name": "langanki",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "langanki",
      "database_id": "37613138-7744-4ba7-993c-f88cbb1a2ee5"
    }
  ]
}
